{
	"name": "@hyvor/design",
	"version": "2.0.0",
	"license": "MIT",
	"private": false,
	"sideEffects": [
		"**/*.css"
	],
	"repository": {
		"url": "https://github.com/hyvor/design"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"package:watch": "svelte-package --watch",
		"package:p": "svelte-kit sync && svelte-package -p",
		"package:pw": "svelte-kit sync && svelte-package -p --watch",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:prettier": "prettier --check .",
		"format": "prettier --write ."
	},
	"exports": {
		"./components": {
			"types": "./dist/components/index.d.ts",
			"svelte": "./dist/components/index.js"
		},
		"./dev": {
			"types": "./dist/dev/markdown.d.ts",
			"default": "./dist/dev/markdown.js"
		},
		"./marketing": {
			"types": "./dist/marketing/index.d.ts",
			"svelte": "./dist/marketing/index.js"
		},
		"./cloud": {
			"types": "./dist/cloud/index.d.ts",
			"svelte": "./dist/cloud/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.0",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@apidevtools/json-schema-ref-parser": "^16.0.2",
		"@hyvor/icons": "^1.1.1",
		"deepmerge-ts": "^8.0.2",
		"emojibase-data": "^17.0.0",
		"intl-messageformat": "^11.2.14",
		"mdsvex": "^0.12.8",
		"shiki": "^4.4.3",
		"svelte-awesome-color-picker": "^4.1.3",
		"tocbot": "^4.36.8"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	}
}
